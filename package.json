{
  "name": "beautidraw",
  "version": "0.1.0",
  "private": true,
  "description": "Layout engine and generator behind the beautidraw Claude Code plugin",
  "type": "module",
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "test": "node --test",
    "setup": "node scripts/setup.mjs",
    "spike": "node scripts/spike/run-all.mjs",
    "spike:network": "node scripts/spike/run-all.mjs --network",
    "bundle": "node scripts/build-bundle.mjs",
    "build:deck": "node scripts/build-deck.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "esbuild": "0.25.10",
    "playwright": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
