node_modules/

# Resolved fresh on each install; only the exact pins in package.json are
# authoritative, so a checked-in lockfile would be a second source of truth.
pnpm-lock.yaml

# Built by `pnpm bundle` from the pinned @excalidraw/excalidraw dependency.
# 27 MB of vendored bundle + fonts — regenerate, don't commit.
scripts/vendor/

.DS_Store
.playwright-mcp/
.scratch/

# Generated deck output. The spec is the source; everything under out/ is derived.
decks/*/out/

# Python virtualenvs (uv-managed; e.g. scripts/qa/.venv — 144 MB Playwright/Pillow env)
.venv/

# Blackboard scene library: regenerable from shards + run-batch.sh + assemble.py (530 MB).
# The manifest.json IS the provenance record and stays tracked.
decks/command-blackboard-library/images-captioned/
